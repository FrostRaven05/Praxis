{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Praxis",
  "version": "0.1.0",
  "identifier": "com.praxis.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @praxis/client dev",
    "beforeBuildCommand": "pnpm --filter @praxis/client build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Praxis",
        "width": 1160,
        "height": 800,
        "minWidth": 680,
        "minHeight": 540,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
