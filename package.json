{
  "name": "praxis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "pnpm --filter @praxis/client dev",
    "admin:preview": "pnpm --filter @praxis/api build && node scripts/admin-preview.mjs",
    "test:admin": "pnpm --filter @praxis/api build && node scripts/admin-smoke.mjs",
    "build": "pnpm typecheck && pnpm --filter @praxis/client build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "desktop": "pnpm --filter @praxis/desktop tauri dev",
    "desktop:build": "pnpm --filter @praxis/desktop tauri build --features tauri/custom-protocol",
    "test:native": "powershell -NoProfile -File scripts/test-native.ps1",
    "test:desktop": "node scripts/native-smoke.mjs",
    "test:p0": "node scripts/native-p0.mjs",
    "test:p1": "node scripts/native-p1.mjs",
    "test:p2": "node scripts/native-p2.mjs",
    "desktop:preview": "powershell -NoProfile -File scripts/preview-desktop.ps1",
    "test:ai": "vitest run apps/api/src/ai.test.ts apps/api/src/ai-provider.test.ts apps/client/src/ai-planner-model.test.ts apps/client/src/ai-mobile-adapter.test.ts",
    "test:ai:desktop": "node scripts/native-ai-planner.mjs",
    "test:ai:live": "pnpm --filter @praxis/api build && node scripts/ai-live-smoke.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/cli": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
